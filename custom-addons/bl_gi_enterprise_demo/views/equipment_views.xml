<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Equipment Form View Extension -->
    <record id="hr_equipment_view_form_gi_inherit" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.gi.inherit</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
            </xpath>
        </field>
    </record>

    <!-- Equipment Kanban View Extension -->
    <record id="hr_equipment_view_kanban_gi_inherit" model="ir.ui.view">
        <field name="name">maintenance.equipment.kanban.gi.inherit</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="image_128" widget="image" invisible="not image_128" options="{'size': [48, 48], 'img_class': 'object-fit-cover rounded'}" class="float-start me-2"/>
            </xpath>
        </field>
    </record>
</odoo>
