<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_invoice_document_bl_fbr" inherit_id="account.report_invoice_document">
        <xpath expr="//t[@t-call='web.external_layout']/div[1]" position="replace"/>
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title" t-value="False"/>
        </xpath>
        <xpath expr="//t[@t-call='web.external_layout']/t[@t-set='forced_vat']" position="after">
            <style>
                .invoice_main, .invoice_main * { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important; }
                .invoice_main { color: #1F2937; font-size: 11px; line-height: 1.35; }
                .invoice_main .page { padding-top: 0 !important; }
                .invoice_main #informations { display: table !important; width: 100% !important; margin: 15px 0 20px !important; }
                .invoice_main #informations &gt; div { display: table-cell !important; width: 20% !important; padding-right: 12px !important; vertical-align: top !important; }
                .invoice_main #informations strong { color: #1E3A8A; font-size: 10px; text-transform: uppercase; letter-spacing: .35px; }
                .invoice_main table[name='invoice_line_table'] { width: 100% !important; border-collapse: collapse !important; table-layout: fixed !important; }
                .invoice_main table[name='invoice_line_table'] thead th { padding: 9px 7px !important; color: #FFFFFF !important; background: #1E3A8A !important; font-size: 10px !important; text-transform: uppercase; letter-spacing: .25px; }
                .invoice_main table[name='invoice_line_table'] tbody td { padding: 10px 7px !important; border-bottom: 1px solid #E5E7EB !important; vertical-align: top !important; }
                .invoice_main table[name='invoice_line_table'] th:first-child,
                .invoice_main table[name='invoice_line_table'] td:first-child { width: 43% !important; }
                .invoice_main #right-elements { width: 43% !important; margin-top: 20px !important; margin-left: 0 !important; float: right !important; }
                .invoice_main #right-elements table { width: 100% !important; }
                .invoice_main #right-elements td { padding: 4px 0 4px 12px !important; }
                .invoice_main #right-elements tr:last-child td { padding-top: 8px !important; border-top: 2px solid #1E3A8A !important; font-size: 14px !important; font-weight: 800 !important; }
            </style>
            <div t-if="o.move_type in ('out_invoice', 'out_refund')"
                 style="margin: 0 0 16px; padding: 0 0 14px; border-bottom: 3px solid #1E3A8A; page-break-inside: avoid; font-family: Arial, Helvetica, sans-serif;">
                <table style="width: 100%; border-collapse: collapse; table-layout: fixed;">
                    <tbody>
                        <tr>
                            <td style="width: 60%; padding: 0; vertical-align: middle;">
                                <img t-if="o.company_id.logo"
                                     t-att-src="image_data_uri(o.company_id.logo)"
                                     t-att-alt="o.company_id.name"
                                     style="max-width: 250px; max-height: 80px; object-fit: contain; object-position: left center;"/>
                                <div t-else="" style="color: #1E3A8A; font-size: 24px; font-weight: 800;"><span t-out="o.company_id.name"/></div>
                            </td>
                            <td style="width: 40%; padding: 0; text-align: right; vertical-align: middle; color: #4B5563; font-size: 10px; line-height: 1.5;">
                                <strong style="font-size: 12px; color: #1E3A8A;"><span t-out="o.company_id.name"/></strong><br/>
                                <span t-out="', '.join(filter(None, [o.company_id.street, o.company_id.city, o.company_id.zip]))"/><br/>
                                <span>NTN: </span><span t-out="o.company_id.bl_fbr_ntn or o.company_id.vat or '—'"/>
                                <t t-if="o.company_id.bl_fbr_strn">
                                    <span> | STRN: </span><span t-out="o.company_id.bl_fbr_strn"/>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 15px 0 0; vertical-align: bottom;">
                                <div style="color: #111827; font-size: 26px; font-weight: 800; line-height: 1.1;">
                                    <span t-if="o.move_type == 'out_refund'">Credit Note </span>
                                    <span t-else="">Tax Invoice </span>
                                    <span t-field="o.name"/>
                                </div>
                            </td>
                            <td style="padding: 15px 0 0; text-align: right; vertical-align: bottom; color: #374151; font-size: 10px; line-height: 1.4;">
                                <span style="color: #1E3A8A; font-weight: 700; text-transform: uppercase; letter-spacing: .5px;">Bill to</span><br/>
                                <strong style="font-size: 11px;" t-field="o.partner_id.name"/><br/>
                                <span t-out="', '.join(filter(None, [o.partner_id.street, o.partner_id.city, o.partner_id.zip]))"/><br/>
                                <span>NTN: </span><span t-out="o.partner_id.bl_fbr_ntn or o.partner_id.vat or '—'"/>
                                <t t-if="o.partner_id.bl_fbr_strn">
                                    <span> | STRN: </span><span t-out="o.partner_id.bl_fbr_strn"/>
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </xpath>
        <xpath expr="//div[@id='right-elements']" position="after">
            <div t-if="o.move_type in ('out_invoice', 'out_refund') and (o.bl_fbr_status == 'submitted' or o.bl_fbr_invoice_number)"
                 style="clear: both; margin-top: 24px; padding: 14px 16px; border: 1.5px solid #1E3A8A; border-left: 7px solid #2563EB; border-radius: 8px; page-break-inside: avoid; font-family: Arial, Helvetica, sans-serif;">
                <table style="width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 11px;">
                    <tbody>
                        <tr>
                            <td style="width: 18%; vertical-align: middle; padding: 0 18px 0 0;">
                                <img t-att-src="o._bl_fbr_report_logo_uri()"
                                     alt="FBR Digital Invoicing System"
                                     style="display: block; width: 104px; height: 104px; object-fit: contain;"/>
                            </td>
                            <td style="width: 57%; vertical-align: top; padding: 0 18px 0 0;">
                                <div style="color: #1E3A8A; font-size: 16px; font-weight: 800; margin: 2px 0 8px;">FBR Digital Invoicing</div>
                                <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                    <tbody>
                                        <tr>
                                            <td style="width: 39%; padding: 2px 0; color: #1E3A8A; font-weight: 700;">Digital reference</td>
                                            <td style="padding: 2px 0; font-weight: 700;"><span t-field="o.bl_fbr_invoice_number"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 2px 0; color: #1E3A8A; font-weight: 700;">Status</td>
                                            <td style="padding: 2px 0; text-transform: capitalize;"><span t-field="o.bl_fbr_status"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 2px 0; color: #1E3A8A; font-weight: 700;">Seller NTN / STRN</td>
                                            <td style="padding: 2px 0;">
                                                <span t-out="o.company_id.bl_fbr_ntn or o.company_id.vat or '—'"/>
                                                <span> / </span>
                                                <span t-out="o.company_id.bl_fbr_strn or o.company_id.company_registry or '—'"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 2px 0; color: #1E3A8A; font-weight: 700;">Buyer registration</td>
                                            <td style="padding: 2px 0;"><span t-out="o.partner_id.bl_fbr_registration_no or o.partner_id.bl_fbr_ntn or '—'"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                            <td style="width: 25%; vertical-align: middle; text-align: right; padding: 0;">
                                <img t-if="o.bl_fbr_qr_code_image"
                                     t-att-src="image_data_uri(o.bl_fbr_qr_code_image)"
                                     alt="FBR digital invoice QR"
                                     style="width: 130px; height: 130px; border: 1px solid #D8E4E3; border-radius: 6px; padding: 5px;"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </xpath>
    </template>
</odoo>
