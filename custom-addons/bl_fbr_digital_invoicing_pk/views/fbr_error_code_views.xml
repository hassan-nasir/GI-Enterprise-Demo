<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_bl_fbr_error_code_list" model="ir.ui.view">
        <field name="name">bl.fbr.error.code.list</field>
        <field name="model">bl.fbr.error.code</field>
        <field name="arch" type="xml">
            <list string="FBR Error Codes">
                <field name="active" column_invisible="True"/>
                <field name="code"/>
                <field name="name"/>
                <field name="friendly_message"/>
                <field name="suggested_fix"/>
            </list>
        </field>
    </record>
    <record id="view_bl_fbr_error_code_form" model="ir.ui.view">
        <field name="name">bl.fbr.error.code.form</field>
        <field name="model">bl.fbr.error.code</field>
        <field name="arch" type="xml">
            <form string="FBR Error Code">
                <sheet>
                    <group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                    </group>
                    <group string="Details">
                        <field name="description"/>
                        <field name="friendly_message"/>
                        <field name="suggested_fix"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_bl_fbr_error_code" model="ir.actions.act_window">
        <field name="name">FBR Error Codes</field>
        <field name="res_model">bl.fbr.error.code</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
