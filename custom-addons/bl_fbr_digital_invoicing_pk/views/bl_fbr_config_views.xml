<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_bl_fbr_config_list" model="ir.ui.view">
        <field name="name">bl.fbr.config.list</field>
        <field name="model">bl.fbr.config</field>
        <field name="arch" type="xml">
            <list string="FBR Configuration">
                <field name="name"/>
                <field name="company_id"/>
                <field name="enabled"/>
                <field name="connection_mode"/>
                <field name="auto_submit_on_post"/>
                <field name="enable_retry_queue"/>
                <field name="lock_invoice_after_submission"/>
            </list>
        </field>
    </record>

    <record id="view_bl_fbr_config_form" model="ir.ui.view">
        <field name="name">bl.fbr.config.form</field>
        <field name="model">bl.fbr.config</field>
        <field name="arch" type="xml">
            <form string="FBR Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="enabled" widget="boolean_toggle"/>
                            <field name="connection_mode" widget="radio"/>
                            <field name="auto_submit_on_post" widget="boolean_toggle"/>
                            <field name="lock_invoice_after_submission" widget="boolean_toggle"/>
                            <field name="show_raw_payload_to_users" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="enable_retry_queue" widget="boolean_toggle"/>
                            <field name="max_retry_attempts"/>
                            <field name="retry_delay_minutes"/>
                            <field name="timeout_seconds"/>
                        </group>
                    </group>
                    <group string="Seller">
                        <group>
                            <field name="seller_registration_no"/>
                            <field name="seller_ntn"/>
                            <field name="seller_strn"/>
                            <field name="seller_province"/>
                        </group>
                        <group>
                            <field name="seller_business_name_override"/>
                        </group>
                    </group>
                    <group string="Sandbox / Production" groups="base.group_system">
                        <field name="sandbox_url"/>
                        <field name="production_url"/>
                        <field name="api_token" password="True"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bl_fbr_config" model="ir.actions.act_window">
        <field name="name">Configuration</field>
        <field name="res_model">bl.fbr.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
