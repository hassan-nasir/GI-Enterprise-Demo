<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="error_invalid_buyer_registration" model="bl.fbr.error.code">
        <field name="code">INVALID_BUYER_REGISTRATION</field>
        <field name="name">Invalid Buyer Registration</field>
        <field name="friendly_message">Buyer registration details were rejected.</field>
        <field name="suggested_fix">Verify buyer registration number, NTN, STRN, and province.</field>
    </record>
    <record id="error_missing_invoice_type" model="bl.fbr.error.code">
        <field name="code">MISSING_INVOICE_TYPE</field>
        <field name="name">Missing Invoice Type</field>
        <field name="suggested_fix">Confirm invoice or credit note mapping.</field>
    </record>
    <record id="error_invalid_date_format" model="bl.fbr.error.code">
        <field name="code">INVALID_DATE_FORMAT</field>
        <field name="name">Invalid Date Format</field>
        <field name="suggested_fix">Verify invoice date formatting for FBR.</field>
    </record>
    <record id="error_missing_buyer_name" model="bl.fbr.error.code">
        <field name="code">MISSING_BUYER_NAME</field>
        <field name="name">Missing Buyer Name</field>
