<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_bl_fbr" model="ir.module.category">
        <field name="name">FBR Digital Invoicing</field>
        <field name="sequence">35</field>
    </record>

    <record id="res_groups_privilege_bl_fbr" model="res.groups.privilege">
        <field name="name">FBR Digital Invoicing</field>
        <field name="category_id" ref="module_category_bl_fbr"/>
        <field name="sequence">35</field>
    </record>

    <record id="group_bl_fbr_user" model="res.groups">
        <field name="name">FBR Digital Invoicing User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_bl_fbr"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_bl_fbr_manager" model="res.groups">
        <field name="name">FBR Digital Invoicing Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_bl_fbr"/>
        <field name="implied_ids" eval="[(4, ref('group_bl_fbr_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_bl_fbr_config_company" model="ir.rule">
        <field name="name">FBR config: allowed companies</field>
        <field name="model_id" ref="model_bl_fbr_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_bl_fbr_manager'))]"/>
    </record>

    <record id="rule_bl_fbr_log_company" model="ir.rule">
        <field name="name">FBR logs: allowed companies</field>
        <field name="model_id" ref="model_bl_fbr_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_bl_fbr_user'))]"/>
    </record>

    <record id="rule_bl_fbr_queue_company" model="ir.rule">
        <field name="name">FBR queue: allowed companies</field>
        <field name="model_id" ref="model_bl_fbr_queue"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_bl_fbr_user'))]"/>
    </record>
</odoo>
